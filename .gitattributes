# Normalize on checkout so Windows and Linux contributors produce identical
# diffs; the repository stores LF.
* text=auto eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

*.dll binary
*.exe binary
*.so binary
*.dylib binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.zip binary
*.ico binary
